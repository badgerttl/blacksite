# Services bind only to the local machine by default. Use 0.0.0.0 for LAN access.
BIND_ADDRESS=127.0.0.1

OPEN_WEBUI_PORT=9000
HOPPSCOTCH_PORT=9001
PROXYSCOTCH_PORT=9159
PROXYSCOTCH_PUBLIC_URL=http://localhost:9159
CLOUDBEAVER_PORT=9002
CYBERCHEF_PORT=9003
REVSHELL_PORT=9004
HACKTRICKS_PORT=9005
SEARXNG_PORT=9006

# Must match how your browser reaches Hoppscotch. Use https/wss behind TLS.
HOPPSCOTCH_PUBLIC_URL=http://localhost:9001
HOPPSCOTCH_WS_URL=ws://localhost:9001
SEARXNG_PUBLIC_URL=http://localhost:9006/

# Generated by `./blacksite init`; do not commit the resulting .env file.
OPEN_WEBUI_SECRET_KEY=GENERATE_ME
OPEN_WEBUI_ADMIN_EMAIL=admin@blacksite.local
OPEN_WEBUI_ADMIN_NAME=Blacksite Admin
OPEN_WEBUI_ADMIN_PASSWORD=GENERATE_ME
# Optional bearer/API token used instead of the administrator password by the
# one-shot tool deployer. Usually leave this empty for a fresh deployment.
OPEN_WEBUI_TOOLS_TOKEN=

# Hardened local defaults. Change both values when publishing through a reverse
# proxy or accessing Open WebUI through another hostname.
OPEN_WEBUI_PUBLIC_URL=http://localhost:9000
OPEN_WEBUI_CORS_ALLOW_ORIGIN=http://localhost:9000;http://127.0.0.1:9000
OPEN_WEBUI_FORWARDED_ALLOW_IPS=127.0.0.1
OPEN_WEBUI_JWT_EXPIRES_IN=24h
OPEN_WEBUI_API_KEYS_ALLOWED_ENDPOINTS=/api/chat/completions,/api/v1/models,/api/models,/api/v1/tools,/api/v1/tasks,/api/v1/retrieval,/api/v1/auths/admin/config,/api/v1/configs/connections
OPEN_WEBUI_RAG_FILE_MAX_SIZE=50
OPEN_WEBUI_RAG_FILE_MAX_COUNT=10
OPEN_WEBUI_RAG_ALLOWED_FILE_EXTENSIONS=.pdf,.txt,.md,.docx,.csv,.tsv,.json,.jsonl,.xml,.html,.nessus,.db,.zip,.yaml,.yml,.log
HOPPSCOTCH_DB_PASSWORD=GENERATE_ME
HOPPSCOTCH_DATA_ENCRYPTION_KEY=GENERATE_ME
HOPPSCOTCH_SESSION_SECRET=GENERATE_ME
PROXYSCOTCH_TOKEN=GENERATE_ME
PROXYSCOTCH_ALLOWED_ORIGINS=http://localhost:9001,http://127.0.0.1:9001
PROXYSCOTCH_BANNED_OUTPUTS=
PROXYSCOTCH_BANNED_DESTS=169.254.169.254,metadata.google.internal,100.100.100.200
SEARXNG_SECRET_KEY=GENERATE_ME

# Optional OpenAI or OpenAI-compatible provider. These can also be set in Open WebUI.
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Default connects Open WebUI to Ollama running on the host. `up --local-llm`
# overrides this with the Ollama container's URL.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Host directories exposed to Open WebUI tools. Input is read-only in the
# container; output is writable. Relative paths resolve from this project.
OPEN_WEBUI_INPUT_DIR=./workspace/input
OPEN_WEBUI_OUTPUT_DIR=./workspace/output

# Track current upstream sources and proxy image. Use a commit/tag to freeze a version.
REVSHELL_REF=HEAD
HACKTRICKS_REF=HEAD
PROXYSCOTCH_REF=latest
